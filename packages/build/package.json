{
  "name": "@glaze/build",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mini-program project builder for Glaze",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "glaze": "./src/cli.ts"
  },
  "dependencies": {
    "@glaze/compiler": "workspace:*",
    "@glaze/runtime": "workspace:*",
    "@glaze/shared": "workspace:*",
    "esbuild": "^0.28.0",
    "solid-js": "^2.0.3",
    "@babel/parser": "^7.28.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "less": "^4.9.1",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "weapp-tailwindcss": "^5.7.5"
  },
  "peerDependencies": {
    "tailwindcss": "^4",
    "weapp-tailwindcss": "^5",
    "less": "^4",
    "sass": "^1"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "weapp-tailwindcss": {
      "optional": true
    },
    "less": {
      "optional": true
    },
    "sass": {
      "optional": true
    }
  }
}
