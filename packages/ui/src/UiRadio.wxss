.glaze-radio {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 56rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.4;
}

.glaze-radio__indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #9ca3af;
  border-radius: 50%;
  background: #ffffff;
}

.glaze-radio--on .glaze-radio__indicator {
  border-color: #111827;
}

.glaze-radio__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #111827;
}

.glaze-radio--disabled {
  opacity: 0.5;
}

.glaze-radio--hover {
  opacity: 0.8;
}
