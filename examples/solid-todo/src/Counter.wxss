.page {
  padding: 32rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 32rpx;
}

.counter {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.btn {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: 48rpx;
  background: #1677ff;
  color: #fff;
  font-size: 44rpx;
}

.count {
  min-width: 120rpx;
  text-align: center;
  font-size: 56rpx;
  font-weight: 600;
  color: #111827;
}

.hint {
  display: block;
  color: #1677ff;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.list {
  margin-top: 32rpx;
  border-top: 1rpx solid #e5e7eb;
}

.footer {
  display: block;
  margin-top: 32rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

.toggle {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border-radius: 32rpx;
  background: #f3f4f6;
  color: #374151;
}
