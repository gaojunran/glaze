.page {
  padding: 32rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 32rpx;
}

.counter {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.btn {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: 48rpx;
  background: #1677ff;
  color: #fff;
  font-size: 44rpx;
}

.count {
  min-width: 120rpx;
  text-align: center;
  font-size: 56rpx;
  font-weight: 600;
  color: #111827;
}

.hint {
  display: block;
  color: #1677ff;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.list {
  margin-top: 32rpx;
  border-top: 1rpx solid #e5e7eb;
}

.footer {
  display: block;
  margin-top: 32rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

.toggle {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: none;
  border-radius: 32rpx;
  background: #f3f4f6;
  color: #374151;
}

.toggle::after {
  border: none;
}

.item-wrap {
  display: flex;
  align-items: center;
}

.remove {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin-left: auto;
  font-size: 26rpx;
  border: none;
  color: #9ca3af;
  background: transparent;
}

.remove::after {
  border: none;
}

.append {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  border: none;
  border-radius: 32rpx;
  background: #ecfdf5;
  color: #047857;
}

.append::after {
  border: none;
}

.ref-probe {
  width: 100rpx;
  height: 1rpx;
  overflow: hidden;
  font-size: 0;
  color: transparent;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.cell {
  width: 72rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  font-size: 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 12rpx;
  background: #fff;
  color: #374151;
}

.cell::after {
  border: none;
}

.prepend {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  border: none;
  border-radius: 32rpx;
  background: #eff6ff;
  color: #1d4ed8;
}

.prepend::after {
  border: none;
}
