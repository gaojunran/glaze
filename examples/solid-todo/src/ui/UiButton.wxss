.glaze-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  min-height: 80rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  background: #f3f4f6;
  color: #111827;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.2;
}

.glaze-button::after {
  border: 0;
}

.glaze-button--primary {
  background: #111827;
  color: #ffffff;
}

.glaze-button--ghost {
  background: transparent;
  color: #111827;
  border-color: #d1d5db;
}

.glaze-button--danger {
  background: #b91c1c;
  color: #ffffff;
}

.glaze-button--sm {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.glaze-button--lg {
  min-height: 96rpx;
  padding: 0 36rpx;
  font-size: 32rpx;
}

.glaze-button--block {
  display: flex;
  width: 100%;
}

.glaze-button--disabled {
  opacity: 0.5;
}
