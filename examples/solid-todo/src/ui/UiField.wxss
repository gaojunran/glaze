.glaze-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 28rpx;
}

.glaze-field__label {
  color: #111827;
  font-size: 28rpx;
  font-weight: 500;
}

.glaze-field__description {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.glaze-field__error {
  color: #b91c1c;
  font-size: 24rpx;
  line-height: 1.4;
}
