<view class="bench">
  <text id="tick">{{tick}}</text>
  <text id="title">{{rows[0].a}}</text>
  <text id="last">{{rows[499].h}}</text>
  <button id="update" class="update" bindtap="updateFirst">update</button>
  <button id="update-all" class="update-all" bindtap="updateAll">update all</button>
  <view class="list">
    <props-row class="row-card" wx:for="{{rows}}" wx:key="id" wx:for-item="row" a="{{row.a}}" b="{{row.b}}" c="{{row.c}}" d="{{row.d}}" e="{{row.e}}" f="{{row.f}}" g="{{row.g}}" h="{{row.h}}" />
  </view>
</view>
