<view class="bench">
  <text id="cell-value">{{rows[0].cells[0].value}}</text>
  <text id="last-cell">{{rows[0].cells[24].value}}</text>
  <button id="cell" class="cell" bindtap="updateCell">cell</button>
  <button id="row" class="row" bindtap="updateRow">row</button>
  <view class="grid">
    <view class="grid-row" wx:for="{{rows}}" wx:for-item="row" wx:key="id">
      <text class="cell" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="id">
        <text class="cell-value">{{cell.value}}</text>
      </text>
    </view>
  </view>
</view>
