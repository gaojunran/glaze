.bench-state-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.state-title {
  font-size: 28rpx;
  color: #374151;
}

.state-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.state-bump {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border-radius: 32rpx;
  background: #f3f4f6;
  color: #374151;
}
