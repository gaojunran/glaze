.bench {
  padding: 24rpx;
}

.bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.update-row,
.append-row,
.delete-row,
.state-bump {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border-radius: 32rpx;
  background: #f3f4f6;
  color: #374151;
}

.bench-row,
.bench-state-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.pure-title,
.state-title {
  font-size: 28rpx;
  color: #374151;
}

.pure-state,
.state-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.pure-state.done {
  color: #16a34a;
}
