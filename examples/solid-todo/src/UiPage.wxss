.ui-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.ui-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 600;
}

.ui-subtitle {
  margin-top: -20rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.ui-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
}

.ui-section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
}

.ui-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.ui-value {
  color: #6b7280;
  font-size: 26rpx;
}

.ui-click-count {
  color: #111827;
  font-size: 26rpx;
  font-weight: 600;
}
